# Server
PORT=8080
NODE_ENV=production

# App URL (used for CORS and redirects). Set to your Coolify/Hetzner public URL.
API_URL=https://your-app.example.com

# JWT (change in production)
JWT_SECRET=your-secret-key-change-in-production

# ── LiveKit (streaming) ─────────────────────────────────────────────────────
# Cloud or self-hosted LiveKit server. Client gets LIVEKIT_URL via /env.js as VITE_LIVEKIT_URL.
LIVEKIT_URL=https://your-livekit.example.com
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# ── Bunny Storage (videos, avatars, media) ──────────────────────────────────
# Storage zone name (e.g. "elix-star" or "elix-star-live")
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_STORAGE_API_KEY=your-storage-api-key
# Region: de, ny, la, sg, etc.
BUNNY_STORAGE_REGION=de
# Optional: custom storage host (defaults to region.storage.bunnycdn.com)
# BUNNY_STORAGE_HOST=storage.bunnycdn.com

# CDN hostname for public URLs (e.g. your-zone.b-cdn.net or custom pull zone)
# Must be set so the frontend can build video/avatar URLs. Exposed to client as VITE_BUNNY_CDN_HOSTNAME.
VITE_BUNNY_CDN_HOSTNAME=your-zone.b-cdn.net

# ── Client-facing URLs (set in Coolify env; served to browser via /env.js) ───
# Your app’s public URL (HTTPS). Used for API and WebSocket.
VITE_API_URL=https://your-app.example.com
VITE_WS_URL=wss://your-app.example.com
# LiveKit is also passed from LIVEKIT_URL → VITE_LIVEKIT_URL in /env.js

# ── Optional: Stripe ───────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Optional: Database (if you add Postgres later) ──────────────────────────
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Optional: CORS (comma-separated origins) ────────────────────────────────
# ALLOWED_ORIGINS=https://your-app.example.com,https://www.example.com
