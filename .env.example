# =============================================================================
# Supabase — required for auth, database, storage, realtime (all features)
# =============================================================================
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-side (Railway / backend): same project, use service role for admin ops
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =============================================================================
# Frontend (Vite) — baked into build; set in Railway Variables for deploy
# =============================================================================
# WebSocket URL when deployed (same host as API = your Railway domain)
# VITE_WS_URL=https://your-app.up.railway.app
# Backend API base URL for report, checkout, etc. Leave empty in dev (Vite proxies /api to localhost:8080)
# VITE_API_URL=https://your-api.up.railway.app
# Optional: disable Supabase in dev (true/false)
# VITE_DISABLE_SUPABASE=false
# Optional: gift assets base (e.g. Supabase storage or CDN)
# VITE_GIFT_ASSET_BASE_URL=

# =============================================================================
# Stripe — payments, checkout, webhooks
# =============================================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# Optional — AI moderation, Apple IAP, etc.
# =============================================================================
# OPENAI_API_KEY=
# INTERNAL_API_KEY=
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_BUNDLE_ID=com.elixstarlive.app
# APPLE_IAP_ENVIRONMENT=Production

# =============================================================================
# Runtime
# =============================================================================
NODE_ENV=production
PORT=8080
