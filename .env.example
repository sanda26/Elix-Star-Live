# Env template — this is the only env file committed.
# Local dev: run `npm run setup:env`, then replace the placeholder values below.
# Production (Coolify): set variables in the dashboard; do not rely on a committed .env file.

## Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173

## Database (PostgreSQL)
# Docker local dev can use host.docker.internal if the database runs on the host machine.
DATABASE_URL=postgresql://username:password@host.docker.internal:5432/database_name

## Auth
JWT_SECRET=replace-with-a-long-random-secret
# Optional legacy fallback still read by some server auth paths.
AUTH_SECRET=

## Bunny Storage / CDN
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_STORAGE_API_KEY=your-bunny-storage-api-key
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_HOSTNAME=your-cdn-hostname.b-cdn.net
BUNNY_STORAGE_REGION=de
VITE_BUNNY_CDN_HOSTNAME=your-cdn-hostname.b-cdn.net
VITE_CDN_URL=https://your-cdn-hostname.b-cdn.net
VITE_GIFT_ASSET_BASE_URL=https://your-cdn-hostname.b-cdn.net

## Bunny Video
BUNNY_LIBRARY_ID=your-bunny-library-id
BUNNY_LIBRARY_API_KEY=your-bunny-library-api-key

## LiveKit
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
VITE_LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud

## Frontend runtime
VITE_API_URL=
VITE_WS_URL=
VITE_ENABLE_CRASH_REPORTING=false
VITE_ADMIN_USER_IDS=
VITE_VAPID_PUBLIC_KEY=

## Stripe — add your keys here (test keys for staging, live keys for production)
# Get keys: https://dashboard.stripe.com/apikeys (toggle Test mode for test keys)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# Webhook secret: https://dashboard.stripe.com/webhooks — add endpoint, copy signing secret
STRIPE_WEBHOOK_SECRET=

## Optional moderation / app store integrations
OPENAI_API_KEY=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=com.elixstarlive.app
APPLE_IAP_ENVIRONMENT=Production
GOOGLE_PLAY_PACKAGE_NAME=com.elixstarlive.app
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=
