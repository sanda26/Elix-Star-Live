# =============================================================================
# Elix Star Live — env template (Hetzner + Bunny CDN + LiveKit Cloud)
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Server (Hetzner)
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
API_URL=https://your-domain.com
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173,capacitor://localhost
JWT_SECRET=<min-32-char-secret>
DATABASE_URL=postgresql://user:password@localhost:5432/elix

# -----------------------------------------------------------------------------
# Frontend (Vite) — baked into build; set when building for production
# -----------------------------------------------------------------------------
VITE_API_URL=https://your-domain.com
VITE_WS_URL=wss://your-domain.com
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
VITE_BUNNY_CDN_HOSTNAME=https://your-zone.b-cdn.net
VITE_GIFT_ASSET_BASE_URL=https://your-zone.b-cdn.net
VITE_APP_NAME=ElixStarLive

# -----------------------------------------------------------------------------
# LiveKit Cloud — live video
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# Bunny Storage & CDN — uploads, avatars, gifts
# -----------------------------------------------------------------------------
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_REGION=de
BUNNY_STORAGE_HOSTNAME=your-zone.b-cdn.net

# -----------------------------------------------------------------------------
# Stripe — payments (optional)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=<your-stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>

# -----------------------------------------------------------------------------
# Optional — AI moderation, Apple IAP
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# INTERNAL_API_KEY=
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_BUNDLE_ID=com.elixstarlive.app
# APPLE_IAP_ENVIRONMENT=Production
