## Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Bunny Storage (Avatars/Images)
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_STORAGE_API_KEY=your-bunny-storage-api-key
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_STORAGE_REGION=de

# Bunny Video (Streaming)
BUNNY_LIBRARY_ID=your-library-id
BUNNY_LIBRARY_API_KEY=your-bunny-library-api-key
VITE_BUNNY_CDN_HOSTNAME=your-zone.b-cdn.net
BUNNY_CDN_HOSTNAME=your-zone.b-cdn.net
VITE_BUNNY_STORAGE_ZONE=your-storage-zone

# LiveKit for Live Streaming
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Auth
JWT_SECRET=your-jwt-secret-min-32-chars

# Frontend Configuration (Production)
CLIENT_URL=https://your-domain.com
VITE_API_URL=https://your-domain.com
VITE_WS_URL=wss://your-domain.com
VITE_APP_NAME="Elix Star Live"
VITE_CDN_URL=https://your-zone.b-cdn.net

# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Stripe (optional - for payments)
# STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Redis (optional - for caching)
# REDIS_URL=redis://localhost:6379
