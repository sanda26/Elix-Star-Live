# =============================================================================
# Server (Hetzner or any Node host)
# =============================================================================
NODE_ENV=production
PORT=8080

# =============================================================================
# Frontend (Vite) — baked into build; set on server for deploy
# =============================================================================
# WebSocket URL when deployed (same host as API = your server domain)
# VITE_WS_URL=https://your-server.example.com
# Backend API base URL. Leave empty in dev (Vite proxies /api to localhost:8080)
# VITE_API_URL=https://your-server.example.com
# Optional: gift assets base (e.g. CDN)
# VITE_GIFT_ASSET_BASE_URL=

# =============================================================================
# Stripe — payments, checkout, webhooks
# =============================================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# Optional — AI moderation, Apple IAP, etc.
# =============================================================================
# OPENAI_API_KEY=
# INTERNAL_API_KEY=
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_BUNDLE_ID=com.elixstarlive.app
# APPLE_IAP_ENVIRONMENT=Production
